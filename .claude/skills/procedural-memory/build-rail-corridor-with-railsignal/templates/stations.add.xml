    <busStop id="stA_arr" lane="SA_A_0" startPos="30" endPos="260" name="Station A (B-&gt;A platform)"/>
    <!-- Station B (nodes SB..B) -->
    <busStop id="stB_dep" lane="B_SB_0" startPos="30" endPos="260" name="Station B (B-&gt;A platform)"/>
    <busStop id="stB_arr" lane="SB_B_0" startPos="30" endPos="260" name="Station B (A-&gt;B platform)"/>
</additional>
